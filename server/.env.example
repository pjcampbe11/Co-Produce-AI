# --- Beat Toolkit SaaS server config (copy to server/.env) ---

# Infra
DATABASE_URL=sqlite:///./beat_saas.db        # or postgresql://user:pass@host/db
REDIS_URL=redis://redis:6379/0               # 'redis' = compose service name
RESULTS_DIR=/data/results
JOB_TIMEOUT=1800

# Queues (two lanes: CPU tasks vs GPU tasks)
CPU_QUEUE=beat-cpu
GPU_QUEUE=beat-gpu
# Which lanes THIS worker consumes (blank = both). Prod CPU box: beat-cpu ; GPU pod: beat-gpu
WORKER_QUEUES=

# Signup / accounts
# Public self-serve signup. Turn OFF in production and mint accounts with ADMIN_TOKEN.
ALLOW_SIGNUP=true
ADMIN_TOKEN=                                 # if set, X-Admin-Token can create accounts when ALLOW_SIGNUP=false
FREE_CREDITS=10

# Rate limiting (requests/min; 0 disables)
RATE_LIMIT_PER_MIN=60      # per API key, on job submit
SIGNUP_LIMIT_PER_MIN=5     # per IP, on signup

# Stripe (test keys shown as placeholders)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://yourapp.com/billing/success
STRIPE_CANCEL_URL=https://yourapp.com/billing/cancel
# Map each Stripe price id -> plan + monthly credit grant:
STRIPE_PRICES={"price_creator_monthly":{"plan":"creator","credits":500},"price_pro_monthly":{"plan":"pro","credits":3000}}
